# 🔐 Environment Variables - Security Configuration

# Server Port
PORT=5000

# Node Environment (development, production)
NODE_ENV=development

# Database URL (Prisma)
DATABASE_URL="file:./dev.db"

# ✅ JWT SECRETS - MUST be long, random, and unique!
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_long_random_jwt_secret_here_at_least_32_characters_minimum
JWT_REFRESH_SECRET=your_super_long_random_refresh_secret_here_at_least_32_characters_minimum

# ✅ CORS Configuration - Allowed Origins
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

# Email Configuration (for future notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Payment Gateway (for future integration)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
